{
  "name": "flip-clock",
  "version": "1.0.0",
  "private": true,
  "description": "A versatile desktop time tool built with Vue 3 + Tauri",
  "homepage": "https://github.com/bimomid/Flip-Clock#readme",
  "bugs": {
    "url": "https://github.com/bimomid/Flip-Clock/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "bimomid",
  "repository": {
    "type": "git",
    "url": "https://github.com/bimomid/Flip-Clock.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "lint": "vp check --fix && pnpm lint:style",
    "lint:style": "stylelint --cache \"**/*.{css,scss,vue}\" --fix",
    "format": "vp fmt",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test --run",
    "test:watch": "vp test",
    "version:sync": "vpx scripts/sync-version.mjs",
    "version:check": "vpx scripts/sync-version.mjs --check",
    "release:plan": "vpx scripts/bump-version.mjs --dry-run",
    "release:bump": "vpx scripts/bump-version.mjs",
    "tauri": "tauri",
    "android:build": "pnpm tauri android build",
    "android:build:debug": "pnpm tauri android build --debug",
    "android:dev": "pnpm tauri android dev",
    "preinstall": "npx only-allow pnpm",
    "prepare": "vp config",
    "commit": "git-cz"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.33",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^20.5.3",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.6",
    "commitizen": "^4.3.1",
    "cz-git": "^1.13.0",
    "only-allow": "^1.2.2",
    "postcss-html": "^1.8.1",
    "sass": "^1.99.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.4.0",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^5.0.5"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
